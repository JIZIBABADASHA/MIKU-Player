{
  "schemaVersion": 1,
  "extensions": [
    {
      "id": "daphne",
      "name": "Daphne",
      "description": "選用的播放內核，提供自己的音訊處理與播放設定。",
      "repo": "cychang-ykc/Daphne",
      "ref": "main",
      "directory": "Daphne",
      "platforms": ["darwin", "win32"],
      "requirements": ["cmake", "cpp"],
      "files": {
        "win32": ["Daphne.Extension.dll", "daphne_core.dll", "web/manifest.json"],
        "darwin": ["extension.js", "engine.js", "bin/daphne-helper", "bin/libdaphne_core.dylib", "web/manifest.json"]
      }
    },
    {
      "id": "moodchannels",
      "name": "MoodWave",
      "description": "依心情自動分台，佇列播完後接著放適合的歌。",
      "repo": "JIZIBABADASHA/MoodWave",
      "ref": "main",
      "directory": "MoodWave",
      "platforms": ["darwin", "win32"],
      "requirements": [],
      "files": {
        "win32": ["MoodChannels.Extension.dll", "web/manifest.json"],
        "darwin": ["extension.js", "bin/moodwave-helper", "web/manifest.json"]
      }
    }
  ]
}
