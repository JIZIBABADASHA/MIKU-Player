<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>MIKU</AssemblyName>
    <RootNamespace>Miku</RootNamespace>
    <Version>1.4.5</Version>
    <InformationalVersion>1.4.5</InformationalVersion>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <!-- don't ship IntelliSense .xml docs with the program -->
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <NoWarn>$(NoWarn);CA1416;WFO1000;SYSLIB0014</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>
  <ItemGroup>
    <!-- mock.js is only the browser preview backend, not needed inside the app -->
    <None Include="wwwroot\**\*" Exclude="wwwroot\mock.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!--
    Optional extension modules (../MIKU.Extensibility/README.md): each one is checked out under ../Extensions/<Name>/
    with a src/<Project>/<Project>.Extension.csproj that provides a MikuDeploy target. Build and publish run it for
    every module found, so the module lands in ext\<id>\ next to MIKU. With no modules nothing changes.
  -->
  <ItemGroup>
    <ProjectReference Include="..\MIKU.Extensibility\MIKU.Extensibility.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <ExtensionsDir Condition="'$(ExtensionsDir)' == ''">$(MSBuildThisFileDirectory)..\Extensions</ExtensionsDir>
  </PropertyGroup>
  <ItemGroup>
    <MikuExtension Include="$(ExtensionsDir)\*\src\*\*.Extension.csproj" />
  </ItemGroup>
  <Target Name="ReportExtensions" BeforeTargets="CoreCompile">
    <Message Importance="high" Text="MIKU: extension %(MikuExtension.Filename)" Condition="'@(MikuExtension)' != ''" />
  </Target>
  <!-- the outer build's RID, output folders and switches are MIKU's: modules choose their own -->
  <PropertyGroup>
    <_MikuExtRemove>RuntimeIdentifier;SelfContained;PublishDir;OutDir;OutputPath;IntermediateOutputPath;DebugType;PublishReferencesDocumentationFiles</_MikuExtRemove>
  </PropertyGroup>
  <!-- restore runs as its own evaluation (MikuRestore=1), so the deploy that follows sees the restored packages -->
  <Target Name="RestoreExtensions" Condition="'@(MikuExtension)' != ''">
    <MSBuild Projects="@(MikuExtension)" Targets="Restore" RemoveProperties="$(_MikuExtRemove)" Properties="Configuration=$(Configuration);MikuRestore=1" />
  </Target>
  <!--
    Each module is deployed by a build of its own: a module that cannot be built on this machine (Daphne without CMake,
    say) is reported as a warning and left out, and MIKU itself and the other modules are still built and published.
    (Inside this build a module's errors would fail all of it, and MIKU's folder would not be updated at all.)
  -->
  <PropertyGroup>
    <_MikuDeploy>&quot;$(DOTNET_HOST_PATH)&quot; msbuild -nologo -v:m -t:MikuDeploy -p:Configuration=$(Configuration)</_MikuDeploy>
    <_MikuDeployFailed>could not be built on this machine and was left out (its output is in the build log); MIKU itself and the other modules are built</_MikuDeployFailed>
  </PropertyGroup>
  <!-- one run per module (target batching): each module's exit code is its own -->
  <Target Name="DeployExtensions" AfterTargets="Build" DependsOnTargets="RestoreExtensions" Condition="'@(MikuExtension)' != ''" Outputs="%(MikuExtension.Identity)">
    <PropertyGroup><_MikuDeployTo>$([MSBuild]::EnsureTrailingSlash($([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\$(OutDir)'))))</_MikuDeployTo></PropertyGroup>
    <!-- the folder ends in \ : doubled, so the closing quote is not escaped on the command line -->
    <Exec Command="$(_MikuDeploy) &quot;%(MikuExtension.FullPath)&quot; &quot;-p:MikuOutDir=$(_MikuDeployTo)\&quot;"
          ContinueOnError="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_MikuExtExit" />
    </Exec>
    <Warning Condition="'$(_MikuExtExit)' != '0'" Text="MIKU: extension %(MikuExtension.Filename) $(_MikuDeployFailed)" />
  </Target>
  <Target Name="PublishExtensions" AfterTargets="Publish" DependsOnTargets="RestoreExtensions" Condition="'@(MikuExtension)' != ''" Outputs="%(MikuExtension.Identity)">
    <PropertyGroup><_MikuDeployTo>$([MSBuild]::EnsureTrailingSlash($([System.IO.Path]::GetFullPath('$([System.IO.Path]::Combine($(MSBuildProjectDirectory), $(PublishDir)))'))))</_MikuDeployTo></PropertyGroup>
    <Exec Command="$(_MikuDeploy) &quot;%(MikuExtension.FullPath)&quot; &quot;-p:MikuOutDir=$(_MikuDeployTo)\&quot;"
          ContinueOnError="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_MikuExtExit" />
    </Exec>
    <Warning Condition="'$(_MikuExtExit)' != '0'" Text="MIKU: extension %(MikuExtension.Filename) $(_MikuDeployFailed)" />
  </Target>
</Project>
