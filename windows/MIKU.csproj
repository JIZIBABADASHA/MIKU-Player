<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>MIKU</AssemblyName>
    <RootNamespace>Miku</RootNamespace>
    <Version>1.3.0</Version>
    <InformationalVersion>1.3.0</InformationalVersion>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <!-- don't ship IntelliSense .xml docs with the program -->
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <NoWarn>$(NoWarn);CA1416;WFO1000;SYSLIB0014</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>
  <!--
    Optional Rplay playback core (Settings.AudioCore = "rplay"): git submodule ../Rplay, a private repo
    (cychang-ykc/Rplay) built from source. Without access, or with the submodule not checked out, RplayEngine.cs
    is left out and the settings omit Rplay: MIKU builds with its own core only. No Rplay code is in this repo.
  -->
  <PropertyGroup>
    <RplayDir Condition="'$(RplayDir)' == ''">$(MSBuildThisFileDirectory)..\Rplay\src</RplayDir>
    <HasRplay Condition="Exists('$(RplayDir)\Rplay.Core\Rplay.Core.csproj') And Exists('$(RplayDir)\Rplay.Endpoint\Rplay.Endpoint.csproj')">true</HasRplay>
    <DefineConstants Condition="'$(HasRplay)' == 'true'">$(DefineConstants);HAS_RPLAY</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(HasRplay)' == 'true'">
    <ProjectReference Include="$(RplayDir)\Rplay.Core\Rplay.Core.csproj" />
    <ProjectReference Include="$(RplayDir)\Rplay.Endpoint\Rplay.Endpoint.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(HasRplay)' != 'true'">
    <Compile Remove="Audio\RplayEngine.cs" />
  </ItemGroup>
  <!-- the Rplay commit, shown in Settings → 關於 (AssemblyMetadata "RplayCommit") -->
  <Target Name="RplayCommit" BeforeTargets="GetAssemblyAttributes" Condition="'$(HasRplay)' == 'true'">
    <Exec Command="git -C &quot;$(RplayDir)\..&quot; rev-parse --short HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="RplayCommit" />
    </Exec>
    <ItemGroup Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(RplayCommit)', '^[0-9a-f]{7,40}$'))">
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>RplayCommit</_Parameter1>
        <_Parameter2>$(RplayCommit)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>
  <Target Name="ReportRplay" BeforeTargets="CoreCompile">
    <Message Importance="high" Text="MIKU: Rplay core $(HasRplay)" Condition="'$(HasRplay)' == 'true'" />
    <Message Importance="high" Text="MIKU: Rplay core not found at $(RplayDir), building with the MIKU core only" Condition="'$(HasRplay)' != 'true'" />
  </Target>
  <ItemGroup>
    <!-- mock.js is only the browser preview backend, not needed inside the app -->
    <None Include="wwwroot\**\*" Exclude="wwwroot\mock.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
